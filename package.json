{
  "name": "food-order-management-api",
  "version": "1.0.0",
  "description": "This project is to manage food orders and statistics.",
  "main": "dist/index.js",
  "scripts": {
    "dev": "ts-node-dev --respawn --transpile-only src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "docker:up": "docker compose --env-file .env -f ./docker/docker-compose.dev.yml up -d",
    "docker:down": "docker compose --env-file .env -f ./docker/docker-compose.dev.yml down"
  },
  "dependencies": {
    "class-transformer": "0.5.1",
    "class-validator": "0.14.2",
    "cors": "2.8.5",
    "dotenv": "17.2.3",
    "express": "5.1.0",
    "pg": "8.16.3",
    "reflect-metadata": "0.2.2",
    "typeorm": "0.3.27"
  },
  "devDependencies": {
    "@types/cors": "2.8.19",
    "@types/express": "5.0.3",
    "@types/node": "24.7.2",
    "@types/pg": "8.15.5",
    "nodemon": "3.1.10",
    "ts-node": "10.9.2",
    "ts-node-dev": "^2.0.0",
    "typescript": "5.9.3"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Lordenil/food-order-management-api.git"
  },
  "keywords": [],
  "author": "Denilson",
